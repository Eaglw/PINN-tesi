filters:
  and:
    - file.inFolder("Runs")
    - file.ext == "md"
views:
  - type: table
    name: Tabella
    order:
      - date
      - file.name
      - epochs
      - staged
      - inverse
      - dataset
      - status
    sort:
      - property: date
        direction: ASC
    columnSize:
      note.date: 149
      file.name: 183
      note.epochs: 82
      note.staged: 72
